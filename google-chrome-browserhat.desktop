[Desktop Entry]
Version=1.0
Type=Application
Name=Browserhat
GenericName=Browser Picker
Comment=Choose which browser profile opens a link
Exec=browserhat %u
Icon=web-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;
StartupNotify=false
NoDisplay=false
